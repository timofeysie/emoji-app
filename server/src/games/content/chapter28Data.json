    "titleTarget": "어디로 모실까요?",
    "titleNative": "Where to?",
    "dialog": [
        {
            "index": 1,
            "speakerNameTarget": "택시 기사",
            "speakerNameNative": "Taxi Driver",
            "speechTarget": "어서 오세요.",
            "speechNative": "Welcome."
        },
        {
            "index": 2,
            "speakerNameTarget": "경호",
            "speakerNameNative": "Kyeong-ho",
            "speechTarget": "안녕하세요.",
            "speechNative": "Hi."
        },
        {
            "index": 3,
            "speakerNameTarget": "택시 기사",
            "speakerNameNative": "Taxi Driver",
            "speechTarget": "어디로 모실까요?",
            "speechNative": "Where to?"
        },
        {
            "index": 4,
            "speakerNameTarget": "경호",
            "speakerNameNative": "Kyeong-ho",
            "speechTarget": "구로 시장으로 가 주세요.",
            "speechNative": "Please take me to Guro Market."
        },
        {
            "index": 5,
            "speakerNameTarget": "택시 기사",
            "speakerNameNative": "Taxi Driver",
            "speechTarget": "네.",
            "speechNative": "Okay."
        },
        {
            "index": 6,
            "speakerNameTarget": "경호",
            "speakerNameNative": "Kyeong-ho",
            "speechTarget": "기사님, 얼마쯤 나올까요?",
            "speechNative": "About how much will it be?"
        },
        {
            "index": 7,
            "speakerNameTarget": "택시 기사",
            "speakerNameNative": "Taxi Driver",
            "speechTarget": "지금은 막히는 시간대가 아니니까 15,000원 정도 나올 것 같네요. 여기서 성산대교 타실 거예요? 아니면 좌측으로 돌아서 갈까요?",
            "speechNative": "I think it will be around 15,000 won since it’s not rush hour now. Do you want to take Seong-san Bridge from here? Or shall we turn left?"
        },
        {
            "index": 8,
            "speakerNameTarget": "경호",
            "speakerNameNative": "Kyeong-ho",
            "speechTarget": "성산대교로 가 주세요.",
            "speechNative": "Please go to Seong-san Bridge."
        },
        {
            "index": 9,
            "speakerNameTarget": "택시 기사",
            "speakerNameNative": "Taxi Driver",
            "speechTarget": "네. 댁이 거기이신가 봐요.",
            "speechNative": "Okay. I guess your house is around there."
        },
        {
            "index": 10,
            "speakerNameTarget": "경호",
            "speakerNameNative": "Kyeong-ho",
            "speechTarget": "네. 구로 시장 근처에 집이 있어요.",
            "speechNative": "Yes, my house is near Guro Market."
        },
        {
            "index": 11,
            "speakerNameTarget": "택시 기사",
            "speakerNameNative": "Taxi Driver",
            "speechTarget": "거기는 집값이 비싸지 않아요?",
            "speechNative": "Are house prices not that high around there?"
        },
        {
            "index": 12,
            "speakerNameTarget": "경호",
            "speakerNameNative": "Kyeong-ho",
            "speechTarget": "주위 다른 곳에 비해서 좀 싼 편이에요. 그리고 교통편도 좋아서 살기 좋은 것 같아요.",
            "speechNative": "It’s a bit cheaper compared to other places nearby. And transportation is convenient, so I think it’s a good place to live."
        },
        {
            "index": 13,
            "speakerNameTarget": "택시 기사",
            "speakerNameNative": "Taxi Driver",
            "speechTarget": "시장 근처에서 살면 좀 시끄럽고 그렇지 않나요?",
            "speechNative": "If you live near a market, isn’t it a bit noisy?"
        },
        {
            "index": 14,
            "speakerNameTarget": "경호",
            "speakerNameNative": "Kyeong-ho",
            "speechTarget": "생각보다 그렇게 시끄럽지는 않더라고요.",
            "speechNative": "I find that it’s not that noisy, unlike what you would think."
        }
    ],
